<Application x:Class="Redline.CompatibilityHarness.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Ui/MainWindow.xaml">
    <Application.Resources>
        <!-- Modern Dark Theme Styles -->
        <SolidColorBrush x:Key="BgDark" Color="#1E1E24" />
        <SolidColorBrush x:Key="CardDark" Color="#282832" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#383848" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0B0" />
        <SolidColorBrush x:Key="AccentRed" Color="#E53935" />
        <SolidColorBrush x:Key="AccentGreen" Color="#43A047" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1E88E5" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FB8C00" />
    </Application.Resources>
</Application>
