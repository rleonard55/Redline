<Window x:Class="Redline.CompatibilityHarness.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redline — Compatibility Diagnostic Harness (Phase 0)"
        Height="850" Width="1100"
        MinHeight="700" MinWidth="900"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#323242" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#424254" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentRed}" />
            <Setter Property="BorderBrush" Value="#C62828" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF5350" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Target Bar -->
            <RowDefinition Height="*" />    <!-- Main Content Split -->
            <RowDefinition Height="Auto" /> <!-- Footer / Export -->
        </Grid.RowDefinitions>

        <!-- HEADER & TARGET BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="REDLINE" Foreground="{DynamicResource AccentRed}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="  |  Compatibility &amp; Capability Probe" Foreground="{DynamicResource TextSecondary}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnPickIn3Seconds" Content="⏱️ Focus Target App in 3s" Margin="0,0,8,0" Click="BtnPickIn3Seconds_Click" />
                        <Button x:Name="BtnPickUnderCursor" Content="🎯 Pick Element Under Cursor" Margin="0,0,8,0" Click="BtnPickUnderCursor_Click" />
                        <Button x:Name="BtnRunAllProbes" Style="{StaticResource PrimaryButton}" Content="▶ Run All Probes" Click="BtnRunAllProbes_Click" />
                    </StackPanel>
                </DockPanel>

                <!-- TARGET INFO SUMMARY -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TARGET PROCESS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="TxtProcess" Text="None selected" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="WINDOW TITLE" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="TxtWindowTitle" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CONTROL TYPE / CLASS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="TxtControlClass" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="FRAMEWORK ID" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="TxtFramework" Text="—" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN SPLIT: PROBES & DIAGNOSTICS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" /> <!-- Left: Individual Probes -->
                <ColumnDefinition Width="2*" /> <!-- Right: Log & Test Summary Table -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: PROBE STATUS CARDS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 1. PATTERN SUPPORT -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="1. Pattern Support" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <TextBlock x:Name="StatusPatterns" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock x:Name="TxtPatternList" Text="SupportsText: — | SupportsValue: — | SupportsScroll: — | IsPassword: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 2. TEXT READ -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="2. Text Reading" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <TextBlock x:Name="StatusTextRead" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock x:Name="TxtReadPreview" Text="Preview: (none)" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtReadStats" Text="Method: — | Duration: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- 3. CARET & SELECTION -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="3. Caret / Selection Tracking" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <TextBlock x:Name="StatusCaret" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock x:Name="TxtCaretInfo" Text="Caret Range: — | Caret Offset: — | Selection Text: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 4. GEOMETRY & SCREEN MAPPING -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="4. Geometry Mapping" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnShowOverlay" Content="👁️ Show Visual Overlay" Margin="0,0,8,0" IsEnabled="False" Click="BtnShowOverlay_Click" />
                                    <TextBlock x:Name="StatusGeometry" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="TxtGeometryInfo" Text="Tested Range: — | Rectangles: — | Reasonable Bounds: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 5. CHANGE DETECTION -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="5. Change Detection" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <Button x:Name="BtnTestTyping" Content="⌨️ Listen for Typing (7s)" Margin="0,0,8,0" DockPanel.Dock="Right" Click="BtnTestTyping_Click" />
                                <TextBlock x:Name="StatusChange" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock x:Name="TxtChangeInfo" Text="TextChangedEvent: — | ValueChangedEvent: — | First Event Latency: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 6. TEXT REPLACEMENT -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="6. Text Modification &amp; Replace" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" />
                                <Button x:Name="BtnTestReplace" Content="✏️ Test Safe Replace" Margin="0,0,8,0" DockPanel.Dock="Right" Click="BtnTestReplace_Click" />
                                <TextBlock x:Name="StatusReplace" Text="⏸️ Not Run" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Right" />
                            </DockPanel>
                            <TextBlock x:Name="TxtReplaceInfo" Text="Method: — | Verified Correct: — | Duration: —" 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: SUMMARY TABLE & EVENT LOG -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <!-- TESTED APPS SUMMARY TABLE -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tested Targets History" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                        <DataGrid x:Name="GridHistory" Grid.Row="1" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True"
                                  Background="#1E1E24" Foreground="{DynamicResource TextPrimary}"
                                  RowBackground="#242430" AlternatingRowBackground="#2C2C3A"
                                  BorderBrush="{DynamicResource CardBorderBrush}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="1.2*" />
                                <DataGridTextColumn Header="Control" Binding="{Binding TargetInfo.ControlType}" Width="*" />
                                <DataGridTextColumn Header="Read" Binding="{Binding TextRead.Success}" Width="45" />
                                <DataGridTextColumn Header="Geom" Binding="{Binding Geometry.CanGetBoundingRectangles}" Width="45" />
                                <DataGridTextColumn Header="Event" Binding="{Binding ChangeDetection.ReceivedTextChangedEvent}" Width="45" />
                                <DataGridTextColumn Header="Repl" Binding="{Binding Replace.Success}" Width="45" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- LIVE LOG OUTPUT -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock Text="Diagnostics Log" FontWeight="Bold" FontSize="12" DockPanel.Dock="Left" />
                            <Button Content="Clear" Padding="6,2" FontSize="10" DockPanel.Dock="Right" Click="BtnClearLog_Click" />
                        </DockPanel>

                        <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" 
                                 Background="#14141A" Foreground="#76E384"
                                 FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER: EXPORTS -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="TxtTargetCount" Text="Recorded Targets: 0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnExportJson" Content="💾 Export Report (JSON)" Margin="0,0,8,0" Click="BtnExportJson_Click" />
                    <Button x:Name="BtnExportMarkdown" Content="📄 Export Report (Markdown)" Click="BtnExportMarkdown_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
