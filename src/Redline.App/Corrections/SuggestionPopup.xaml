<Window x:Class="Redline.App.Corrections.SuggestionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True"
        Left="-10000" Top="-10000"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F0067C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" Background="White" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" MinWidth="240" MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Margin="6">
            <StackPanel Orientation="Horizontal" Margin="10,6,10,2">
                <Border x:Name="CategoryBadge" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="CategoryText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="OriginalText" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextDecorations="Strikethrough" Foreground="#A0000000" TextTrimming="CharacterEllipsis" MaxWidth="300" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Margin="10,2,10,6" TextWrapping="Wrap" Foreground="#C0000000" />

            <StackPanel x:Name="SuggestionList" />
            <TextBlock x:Name="NoSuggestions" Margin="10,2,10,4" Foreground="#80000000" FontStyle="Italic"
                       Text="No suggestions" Visibility="Collapsed" />

            <Separator Margin="6,4" />
            <Button x:Name="AddToDictionaryButton" Style="{StaticResource ItemButton}" Click="AddToDictionary_Click">
                <TextBlock><Run Text="Add to dictionary" /><Run Text="   D" Foreground="#80000000" /></TextBlock>
            </Button>
            <Button Style="{StaticResource ItemButton}" Click="Ignore_Click">
                <TextBlock><Run Text="Ignore" /><Run Text="   I" Foreground="#80000000" /></TextBlock>
            </Button>
            <Button x:Name="IgnoreRuleButton" Style="{StaticResource ItemButton}" Click="IgnoreRule_Click">
                <TextBlock><Run Text="Ignore this rule everywhere" /><Run Text="   R" Foreground="#80000000" /></TextBlock>
            </Button>
        </StackPanel>
    </Border>
</Window>
