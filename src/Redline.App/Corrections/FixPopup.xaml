<Window x:Class="Redline.App.Corrections.FixPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True"
        Left="-10000" Top="-10000"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Foreground="{DynamicResource Flyout.Text}">
    <Window.Resources>
        <Style x:Key="ItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Flyout.Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Flyout.Border}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flyout.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flyout.KeyboardFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScopeButton" TargetType="Button" BasedOn="{StaticResource ItemButton}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Margin="8" Background="{DynamicResource Flyout.Background}" BorderBrush="{DynamicResource Flyout.Border}" BorderThickness="1" CornerRadius="8" MinWidth="320" MaxWidth="480">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Margin="6">
            <DockPanel Margin="10,6,6,4">
                <StackPanel x:Name="ScopeButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SentenceButton" Style="{StaticResource ScopeButton}" Click="Sentence_Click" Margin="0,0,4,0" ToolTip="S">Sentence</Button>
                    <Button x:Name="ParagraphButton" Style="{StaticResource ScopeButton}" Click="Paragraph_Click" ToolTip="P">Paragraph</Button>
                </StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="10,2,10,6">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>

            <Separator Margin="6,2" Background="{DynamicResource Flyout.Divider}" />
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="ChangeList" Margin="10,4,10,2" />
                    <TextBlock x:Name="NoChanges" Margin="10,2,10,4" Foreground="{DynamicResource Flyout.MutedText}" FontStyle="Italic"
                               Text="No spelling or grammar fixes here." Visibility="Collapsed" />
                    <TextBlock x:Name="AiHeader" Margin="10,8,10,2" FontSize="12" Foreground="{DynamicResource Flyout.SecondaryText}"
                               Text="AI grammar model - whole sentence" Visibility="Collapsed" />
                    <StackPanel x:Name="AlternativeList" Margin="10,0,10,2" />
                    <TextBlock x:Name="AiStatus" Margin="10,4,10,2" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource Flyout.MutedText}"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Separator Margin="6,4" Background="{DynamicResource Flyout.Divider}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,0,6,4">
                <Button x:Name="ApplyButton" Style="{StaticResource ItemButton}" BorderThickness="1" Click="Apply_Click" Margin="0,0,6,0" />
                <Button Style="{StaticResource ItemButton}" Click="Cancel_Click">Cancel</Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
