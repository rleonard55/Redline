<Window x:Class="Redline.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redline — Settings"
        Width="560" Height="520" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Changes are saved as you make them." />
            <Button Content="Close" Width="80" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="EnabledBox" Content="Check spelling and grammar (uncheck to pause)"
                              Checked="General_Changed" Unchecked="General_Changed" Margin="0" />

                    <TextBlock Style="{StaticResource Label}" Text="Spelling language" />
                    <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" IsEditable="True"
                              LostFocus="Language_Commit" SelectionChanged="Language_SelectionChanged" />
                    <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" />

                    <TextBlock Style="{StaticResource Label}" Text="Check after I stop typing for" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="DelaySlider" Width="260" Minimum="100" Maximum="2000"
                                TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="500"
                                ValueChanged="Delay_Changed" />
                        <TextBlock x:Name="DelayText" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Suggestion hotkey" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                 ToolTip="Click, then press the new combination (needs Ctrl, Alt or Win)" />
                        <Button Content="Reset" Margin="8,0,0,0" Padding="10,0" Click="HotkeyReset_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" />

                    <CheckBox x:Name="HoverBox" Content="Show a quick fix when I point at an underline" Margin="0,12,0,0"
                              Checked="General_Changed" Unchecked="General_Changed" />

                    <CheckBox x:Name="StartupBox" Content="Start Redline when I sign in to Windows" Margin="0,16,0,0"
                              Checked="General_Changed" Unchecked="General_Changed" />
                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Writing">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Choose which kinds of issues are underlined." />
                    <CheckBox x:Name="SpellingBox" Content="Spelling" Checked="Writing_Changed" Unchecked="Writing_Changed" />
                    <CheckBox x:Name="GrammarBox" Content="Grammar and punctuation" Checked="Writing_Changed" Unchecked="Writing_Changed" />
                    <CheckBox x:Name="StyleBox" Content="Style suggestions (wordiness, readability)" Checked="Writing_Changed" Unchecked="Writing_Changed" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Apps">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Redline never reads text in these apps. Password fields, terminals and the built-in apps below are always skipped." />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Add" Width="70" Margin="8,0,0,0" Click="ExcludeAdd_Click" />
                        <ComboBox x:Name="ExcludeInput" IsEditable="True"
                                  ToolTip="Program file name, e.g. MyVault.exe — or pick a running app" />
                    </DockPanel>
                    <!-- Bottom-docked children stack upward in declaration order. -->
                    <ListBox x:Name="BuiltInList" DockPanel.Dock="Bottom" Height="90" Foreground="#666" Focusable="False">
                        <!-- Read-only but still scrollable (IsEnabled=False would block the scrollbar). -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Label}" Text="Always skipped (built in)" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Remove" Width="70" Click="ExcludeRemove_Click" />
                        <TextBlock />
                    </DockPanel>
                    <ListBox x:Name="ExcludedList" SelectionMode="Extended" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Dictionary">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Margin="0,0,0,4" Text="Words added to the dictionary" />
                    <ListBox Grid.Row="1" x:Name="WordList" SelectionMode="Extended" />
                    <Button Grid.Row="2" Content="Remove" Width="70" HorizontalAlignment="Right" Margin="0,6,0,0" Click="WordRemove_Click" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Ignored rules" />
                    <ListBox Grid.Row="4" x:Name="RuleList" SelectionMode="Extended" />
                    <Button Grid.Row="5" Content="Restore" Width="70" HorizontalAlignment="Right" Margin="0,6,0,0" Click="RuleRestore_Click" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
