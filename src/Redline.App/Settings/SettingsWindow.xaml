<Window x:Class="Redline.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redline — Settings"
        Width="680" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Changes are saved as you make them." />
            <Button Content="Close" Width="80" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <TabControl x:Name="Tabs" TabStripPlacement="Left">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <CheckBox x:Name="EnabledBox" Content="Check spelling and grammar (uncheck to pause)"
                              Checked="General_Changed" Unchecked="General_Changed" Margin="0" />

                    <TextBlock Style="{StaticResource Label}" Text="Spelling language" />
                    <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" IsEditable="True"
                              LostFocus="Language_Commit" SelectionChanged="Language_SelectionChanged" />
                    <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" />

                    <TextBlock Style="{StaticResource Label}" Text="Check after I stop typing for" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="DelaySlider" Width="260" Minimum="100" Maximum="2000"
                                TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="500"
                                ValueChanged="Delay_Changed" />
                        <TextBlock x:Name="DelayText" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Suggestion hotkey" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                 ToolTip="Click, then press the new combination (needs Ctrl, Alt or Win)" />
                        <Button Content="Reset" Margin="8,0,0,0" Padding="10,0" Click="HotkeyReset_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" />

                    <CheckBox x:Name="HoverBox" Content="Show a quick fix when I point at an underline" Margin="0,12,0,0"
                              Checked="General_Changed" Unchecked="General_Changed" />
                    <CheckBox x:Name="GutterBox" Content="Show a bar beside paragraphs with several fixes" Margin="0,8,0,0"
                              Checked="General_Changed" Unchecked="General_Changed" />

                    <CheckBox x:Name="StartupBox" Content="Start Redline when I sign in to Windows" Margin="0,16,0,0"
                              Checked="General_Changed" Unchecked="General_Changed" />
                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Writing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Choose which kinds of issues are underlined." />
                    <CheckBox x:Name="SpellingBox" Margin="0,6,0,0" Content="Spelling" Checked="Writing_Changed" Unchecked="Writing_Changed" />
                    <CheckBox x:Name="GrammarBox" Margin="0,6,0,0" Content="Grammar and punctuation" Checked="Writing_Changed" Unchecked="Writing_Changed" />
                    <CheckBox x:Name="StyleBox" Margin="0,6,0,0" Content="Style suggestions (wordiness, readability)" Checked="Writing_Changed" Unchecked="Writing_Changed" />

                    <TextBlock Style="{StaticResource Label}" Margin="0,24,0,4" Text="AI grammar check" />
                    <CheckBox x:Name="AiGrammarBox" Margin="0" Content="Also check grammar with an AI model on this PC"
                              Checked="Writing_Changed" Unchecked="Writing_Changed" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Catches errors the built-in rules miss, such as &quot;She go to school&quot;. The model runs entirely on this PC: your text never leaves it. It needs a one-time 806 MB download and about 1 GB of memory while in use (freed after 10 idle minutes). Its suggestions appear a moment after the others." />
                    <CheckBox x:Name="AiGpuBox" Margin="0,10,0,0" Content="Use the graphics card (GPU) when available"
                              Checked="Writing_Changed" Unchecked="Writing_Changed"
                              ToolTip="Works with NVIDIA, AMD and Intel graphics through Vulkan. Keeps the processor free; falls back to the processor when there's no usable GPU." />
                    <TextBlock x:Name="AiDeviceHint" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ModelDownloadButton" Content="Download model" Padding="10,2" Click="ModelDownload_Click" />
                        <Button x:Name="ModelCancelButton" Content="Cancel download" Padding="10,2" Click="ModelCancel_Click" />
                        <Button x:Name="ModelRemoveButton" Content="Remove model" Padding="10,2" Click="ModelRemove_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="ModelProgress" Height="4" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" />
                    <TextBlock x:Name="ModelStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0">
                        <Run Text="Model:" />
                        <Hyperlink Click="ModelPage_Click" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">GRMR-V3-G1B</Hyperlink><Run Text=" (Apache-2.0), fine-tuned from Gemma 3 1B and subject to the" />
                        <Hyperlink Click="GemmaTerms_Click" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">Gemma Terms of Use</Hyperlink><Run Text="." />
                    </TextBlock>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Apps">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Redline never reads text in these apps. Password fields, terminals and the built-in apps below are always skipped." />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Add" Width="70" Margin="8,0,0,0" Click="ExcludeAdd_Click" />
                        <ComboBox x:Name="ExcludeInput" IsEditable="True"
                                  ToolTip="Program file name, e.g. MyVault.exe — or pick a running app" />
                    </DockPanel>
                    <!-- Bottom-docked children stack upward in declaration order. -->
                    <ListBox x:Name="BuiltInList" DockPanel.Dock="Bottom" Height="90" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Focusable="False">
                        <!-- Read-only but still scrollable (IsEnabled=False would block the scrollbar). -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Label}" Text="Always skipped (built in)" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Remove" Width="70" Click="ExcludeRemove_Click" />
                        <TextBlock />
                    </DockPanel>
                    <ListBox x:Name="ExcludedList" SelectionMode="Extended" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Compatibility">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="How Redline has worked in the apps you've used over the last 30 days. This record stays on this PC: it lists apps, their versions and the kinds of text fields, with counts. It never includes what you type, window titles or web addresses. Nothing is sent unless you choose Report a problem and submit the issue it opens." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="CompatIssueButton" Content="Report a problem" Padding="10,2" Click="CompatIssue_Click" IsEnabled="False"
                                ToolTip="Opens a pre-filled public GitHub issue with the selected app's record. You can read and edit everything before submitting." />
                        <Button Content="View report" Padding="10,2" Margin="8,0,0,0" Click="CompatReport_Click"
                                ToolTip="The exact contents of the record" />
                        <Button Content="Clear" Padding="10,2" Margin="8,0,0,0" Click="CompatClear_Click" />
                    </StackPanel>
                    <DataGrid x:Name="CompatGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="CompatGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding App}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.4*" />
                            <DataGridTextColumn Header="Last used" Binding="{Binding LastSeen}" Width="Auto" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Details}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Dictionary">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Margin="0,0,0,4" Text="Words added to the dictionary" />
                    <ListBox Grid.Row="1" x:Name="WordList" SelectionMode="Extended" />
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Remove" Width="70" Click="WordRemove_Click" />
                        <Button DockPanel.Dock="Left" Content="Import..." Padding="10,2" Click="WordImport_Click"
                                ToolTip="Add the words from a Word custom dictionary (CUSTOM.DIC) or a text file with one word per line" />
                        <TextBlock x:Name="ImportResult" Style="{StaticResource Hint}" Margin="10,0" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Ignored rules" />
                    <ListBox Grid.Row="4" x:Name="RuleList" SelectionMode="Extended" />
                    <Button Grid.Row="5" Content="Restore" Width="70" HorizontalAlignment="Right" Margin="0,6,0,0" Click="RuleRestore_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <StackPanel Margin="12">
                    <CheckBox x:Name="DiagnosticsBox" Content="Diagnostics mode (detailed logs and timing summaries)" Margin="0"
                              Checked="Diagnostics_Changed" Unchecked="Diagnostics_Changed" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Turn this on when reporting a problem. Logs never contain the text you type; they are kept for 7 days (50 MB at most)." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open logs folder" Padding="10,2" Click="OpenLogs_Click" />
                    </StackPanel>
                    <TextBlock x:Name="LogsHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="12">
                    <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Local spelling and grammar checking for Windows. Spelling uses the Windows spell checker; grammar uses Harper." />

                    <TextBlock Style="{StaticResource Label}" Text="Updates" />
                    <CheckBox x:Name="UpdatesBox" Content="Check for updates automatically (once a day)" Margin="0"
                              Checked="Updates_Changed" Unchecked="Updates_Changed" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Checking asks GitHub for the latest release; only Redline's version number is sent, never your text. Updates install only when you choose." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CheckNowButton" Content="Check now" Padding="10,2" Click="CheckNow_Click" />
                        <Button x:Name="InstallUpdateButton" Content="Install update" Padding="10,2" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="InstallUpdate_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" />

                    <TextBlock Style="{StaticResource Label}" Text="Licenses" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Redline is open source under the MIT license. It includes Harper (Apache-2.0), Rust libraries and the .NET runtime, each under its own license." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Third-party notices" Padding="10,2" Click="Notices_Click" />
                        <Button Content="Redline on GitHub" Padding="10,2" Margin="8,0,0,0" Click="GitHub_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
