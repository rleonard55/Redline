<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Redline.App</RootNamespace>
    <AssemblyName>Redline</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Redline.ico</ApplicationIcon>
    <!-- English-only UI: don't publish the framework's localized resource folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 wants WinForms' SetHighDpiMode; this is a WPF app, where PerMonitorV2 belongs in the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for NotifyIcon; keep its namespace out of global usings to avoid WPF clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Redline.Core\Redline.Core.csproj" />
    <ProjectReference Include="..\Redline.Windows\Redline.Windows.csproj" />
    <ProjectReference Include="..\Redline.Annotations\Redline.Annotations.csproj" />
    <ProjectReference Include="..\Redline.Analysis\Redline.Analysis.csproj" />
    <ProjectReference Include="..\Redline.Analysis.Harper\Redline.Analysis.Harper.csproj" />
  </ItemGroup>
</Project>
