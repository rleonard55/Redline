<Window x:Class="Redline.App.Diagnostics.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redline — Diagnostics"
        Width="980" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,2,12,2" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Surface" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Surface}" />
            <TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Capabilities" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Capabilities}" />
            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Snapshot" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Snapshot}" />
            <TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Last analysis" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Analysis}" />
            <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Analyzers" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Analyzers}" />
        </Grid>

        <DataGrid Grid.Row="1" x:Name="IssueGrid" ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  SelectionMode="Single" MouseDoubleClick="IssueGrid_MouseDoubleClick"
                  ToolTip="Double-click an issue to fix it (or use the suggestion hotkey in the app)">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="60" />
                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="120" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" />
                <DataGridTextColumn Header="Suggestions" Binding="{Binding Suggestions}" Width="*" />
                <DataGridTextColumn Header="Analyzer" Binding="{Binding Analyzer}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,10,0,4" FontWeight="SemiBold"
                   Text="Log (never contains document text)" />
        <ListBox Grid.Row="3" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"
                 x:Name="LogList" />
    </Grid>
</Window>
