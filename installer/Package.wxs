<!--
  Redline MSI: per-user (no elevation), installs to %LOCALAPPDATA%\Programs\Redline.
  Properties (msiexec /i Redline.msi NAME=value):
    STARTWITHWINDOWS  1 (default) registers HKCU Run "Redline"; on upgrade the user's current choice wins.
    LAUNCHAPP         1 (default) starts Redline when installation finishes.
  User data (%LOCALAPPDATA%\Redline: settings, dictionary, logs) is left in place on uninstall.

  Offline variant (build.ps1 -Offline defines ModelDir): also installs the GRMR-V3 grammar model, its NOTICE and
  license texts into %LOCALAPPDATA%\Redline\models, where the app looks for a downloaded model. Those components are
  Permanent: a later regular (model-less) upgrade or an uninstall leaves the model, like the rest of the user data.
  The model is a Gemma derivative, so this variant shows a license agreement (Gemma Terms of Use 3.1: the use
  restrictions must be part of an agreement governing its use).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Redline"
           Manufacturer="Redline"
           Version="$(var.ProductVersion)"
           UpgradeCode="28A90438-1D75-4474-8643-69FBD4944DE3"
           Scope="perUser"
           Language="1033">

    <!-- Same-version upgrades: the offline and regular MSIs of one version replace each other instead of
         installing side by side.
         afterInstallExecute: the old version is removed only after the new one is fully installed, so a cancelled
         or failed upgrade rolls back to the old version intact. (afterInstallValidate removed it first; a cancel
         during an upgrade on 2026-10-05 left no Redline installed at all.) Shared files survive the removal because
         their components keep the same GUIDs across versions (WiX derives them from the install paths). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Redline is already installed." AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallExecute" />
<?ifdef ModelDir?>
    <!-- The model is already compressed (quantized weights): store it as is, in its own cabinet. -->
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" CompressionLevel="high" />
    <Media Id="2" Cabinet="model.cab" EmbedCab="yes" CompressionLevel="none" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
<?else?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
<?endif?>

    <Icon Id="RedlineIcon" SourceFile="$(var.RepoRoot)src\Redline.App\Redline.ico" />
    <Property Id="ARPPRODUCTICON" Value="RedlineIcon" />
<?ifndef ModelDir?>
    <Property Id="ARPNOMODIFY" Value="1" /> <!-- WixUI_Minimal (offline variant) sets it itself -->
<?endif?>

    <Property Id="STARTWITHWINDOWS" Value="1" Secure="yes" />
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />

    <!-- Read before the old version is removed: an upgrade keeps start-with-Windows only if it is on now. -->
    <Property Id="EXISTINGRUNVALUE" Secure="yes">
      <RegistrySearch Id="ExistingRunValue" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="Redline" Type="raw" />
    </Property>
    <SetProperty Id="STARTWITHWINDOWS" Value="0" Before="CostFinalize" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND NOT EXISTINGRUNVALUE" />

    <!--
      Before files are replaced or removed, ask a running Redline to quit (Redline.exe with the exit switch
      signals it and waits, killing it after 10 s). WiX's util:CloseApplication can't do this: WM_CLOSE only closes
      a tray app's hidden windows, and it runs after RemoveFiles on uninstall.
    -->
    <CustomAction Id="ExitRunningRedline" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Redline.exe&quot; --exit" Return="ignore" Impersonate="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Redline" />
      </Directory>
<?ifdef ModelDir?>
      <Directory Id="UserDataFolder" Name="Redline">
        <Directory Id="MODELFOLDER" Name="models" />
      </Directory>
<?endif?>
    </StandardDirectory>

    <Feature Id="Main" Title="Redline">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RunAtSignIn" />
<?ifdef ModelDir?>
      <ComponentGroupRef Id="ModelFiles" />
<?endif?>
    </Feature>

<?ifdef ModelDir?>
    <ComponentGroup Id="ModelFiles" Directory="MODELFOLDER">
      <Component Id="GrammarModel" Permanent="yes">
        <File Id="GrammarModelFile" Source="$(var.ModelDir)GRMR-V3-G1B-Q4_K_M.gguf" DiskId="2" KeyPath="yes" />
      </Component>
      <Component Id="GrammarModelNotice" Permanent="yes">
        <File Id="GrammarModelNoticeFile" Source="$(var.ModelDir)NOTICE.txt" DiskId="2" KeyPath="yes" />
      </Component>
      <Component Id="GrammarModelGemmaTerms" Permanent="yes">
        <File Id="GrammarModelGemmaTermsFile" Source="$(var.ModelDir)Gemma-Terms-of-Use.txt" DiskId="2" KeyPath="yes" />
      </Component>
      <Component Id="GrammarModelGemmaPolicy" Permanent="yes">
        <File Id="GrammarModelGemmaPolicyFile" Source="$(var.ModelDir)Gemma-Prohibited-Use-Policy.txt" DiskId="2" KeyPath="yes" />
      </Component>
      <Component Id="GrammarModelLicense" Permanent="yes">
        <File Id="GrammarModelLicenseFile" Source="$(var.ModelDir)GRMR-V3-G1B-LICENSE.txt" DiskId="2" KeyPath="yes" />
      </Component>
    </ComponentGroup>
<?endif?>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe">
        <File Id="RedlineExe" Source="$(var.PublishDir)Redline.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)Redline.exe" />
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="RedlineShortcut" Name="Redline" Description="System-wide spelling and grammar checking"
                  Target="[#RedlineExe]" WorkingDirectory="INSTALLFOLDER" Icon="RedlineIcon" />
        <RegistryValue Root="HKCU" Key="Software\Redline\Installer" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- The app shows this as Settings › Start with Windows and may remove it when the user turns that off. -->
    <Component Id="RunAtSignIn" Directory="INSTALLFOLDER" Condition="STARTWITHWINDOWS = 1">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Redline" Type="string"
                     Value="&quot;[#RedlineExe]&quot;" KeyPath="yes" />
    </Component>

    <CustomAction Id="LaunchRedline" FileRef="RedlineExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
<?ifdef FailTest?>
    <!-- Test builds only (-p:FailTest=1): fail after the files are copied, to check that the rollback leaves the
         previously installed version intact. Never in a shipped MSI. -->
    <CustomAction Id="TestFailure" Error="Redline test build: failing on purpose after InstallFiles." />
<?endif?>
    <InstallExecuteSequence>
<?ifdef FailTest?>
      <Custom Action="TestFailure" After="InstallFiles" Condition="NOT REMOVE" />
<?endif?>
      <Custom Action="ExitRunningRedline" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="LaunchRedline" After="InstallFinalize" Condition="LAUNCHAPP = 1 AND NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
